{
  "name": "fieldsolo",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "react-native": "0.86.3",
    "@react-native/virtualized-lists": "0.86.3",
    "react-native-worklets": "0.10.1"
  },
  "scripts": {
    "test": "npm run test:api-client && npm run test:marketing && npm run test:edge-functions && npm run test:design-system",
    "test:design-system": "npx vitest run packages/design-system/lib/contrast.test.ts",
    "test:api-client": "vitest run packages/api-client/src/jobs.test.ts packages/api-client/src/sessions.test.ts packages/api-client/src/notes.test.ts packages/api-client/src/materials.test.ts packages/api-client/src/liveSessions.test.ts packages/api-client/src/inbox.test.ts packages/api-client/src/consent.test.ts packages/api-client/src/analyticsConsent.test.ts packages/api-client/src/profiles.test.ts packages/api-client/src/jobExports.test.ts packages/api-client/src/sessionDurationDraft.test.ts packages/api-client/src/applyJobDetailEdit.test.ts",
    "test:marketing": "npm run test -w @fieldsolo/marketing",
    "test:edge-functions": "vitest run backend/supabase/functions/_shared/*.test.ts",
    "test:mobile": "npm run test -w mobile-expo",
    "test:db": "npm run test:db:job-costs-soft-delete && npm run test:db:consent-rls && npm run test:db:prelaunch-hardening && npm run test:db:legacy-cost-review && npm run test:db:legacy-profile-upsert && npm run test:db:job-exports && npm run test:db:apply-job-detail-edit",
    "test:db:job-costs-soft-delete": "PGPASSWORD=postgres psql -h 127.0.0.1 -p 54322 -U postgres -d postgres -v ON_ERROR_STOP=1 -f backend/supabase/tests/materials_soft_delete.test.sql",
    "test:db:consent-rls": "PGPASSWORD=postgres psql -h 127.0.0.1 -p 54322 -U postgres -d postgres -v ON_ERROR_STOP=1 -f backend/supabase/tests/consent_tables_rls.test.sql",
    "test:db:prelaunch-hardening": "PGPASSWORD=postgres psql -h 127.0.0.1 -p 54322 -U postgres -d postgres -v ON_ERROR_STOP=1 -f backend/supabase/tests/prelaunch_hardening.test.sql",
    "test:db:legacy-cost-review": "PGPASSWORD=postgres psql -h 127.0.0.1 -p 54322 -U postgres -d postgres -v ON_ERROR_STOP=1 -f backend/supabase/tests/legacy_costs_reviewed_at_compat.test.sql",
    "test:db:legacy-profile-upsert": "PGPASSWORD=postgres psql -h 127.0.0.1 -p 54322 -U postgres -d postgres -v ON_ERROR_STOP=1 -f backend/supabase/tests/legacy_profile_upsert_compat.test.sql",
    "test:db:job-exports": "PGPASSWORD=postgres psql -h 127.0.0.1 -p 54322 -U postgres -d postgres -v ON_ERROR_STOP=1 -f backend/supabase/tests/job_exports_schema.test.sql",
    "test:db:apply-job-detail-edit": "PGPASSWORD=postgres psql -h 127.0.0.1 -p 54322 -U postgres -d postgres -v ON_ERROR_STOP=1 -f backend/supabase/tests/apply_job_detail_edit.test.sql",
    "typecheck": "tsc -p packages/shared-types/tsconfig.json --noEmit && tsc -p packages/api-client/tsconfig.json --noEmit && tsc -p packages/design-system/tsconfig.json --noEmit && tsc -p apps/mobile-expo/tsconfig.json --noEmit && tsc -p apps/marketing/tsconfig.json --noEmit",
    "design:check": "node scripts/design-check.mjs",
    "product:html:check": "node scripts/design-check.mjs --html-only",
    "product:export": "node scripts/export-product-context.mjs",
    "marketing": "npm run dev -w @fieldsolo/marketing",
    "marketing:build": "npm run build -w @fieldsolo/marketing",
    "mobile": "npm run start -w mobile-expo",
    "mobile:android": "npm run android -w mobile-expo",
    "mobile:android:go": "npm run android:go -w mobile-expo",
    "mobile:ios": "npm run ios -w mobile-expo",
    "local:setup": "node scripts/configure-local-mobile-env.mjs",
    "dev:local": "npm run local:setup && npm run mobile",
    "db:start": "npx supabase start --workdir backend",
    "db:stop": "npx supabase stop --workdir backend",
    "db:reset": "npx supabase db reset --local --workdir backend",
    "db:verify": "npm run db:reset && npm run test:db",
    "screenshots:reset": "node scripts/seed-app-store-demo.mjs",
    "db:deploy:staging:plan": "node scripts/supabase-deploy.mjs staging",
    "db:deploy:staging": "node scripts/supabase-deploy.mjs staging --apply",
    "db:deploy:production:plan": "node scripts/supabase-deploy.mjs production",
    "db:deploy:production": "node scripts/supabase-deploy.mjs production --apply"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.4",
    "supabase": "^2.98.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.4"
  }
}
