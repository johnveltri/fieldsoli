{
  "expo": {
    "name": "FieldSoli",
    "slug": "fieldsolo",
    "scheme": "fieldsoli",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/brand/fieldsoli-solo-notch-light.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.veltriventures.fieldsoli",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationDefaultAccuracyReduced": true
      },
      "icon": {
        "light": "./assets/brand/fieldsoli-solo-notch-light.png",
        "dark": "./assets/brand/fieldsoli-solo-notch-dark.png"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "blockedPermissions": ["android.permission.ACCESS_FINE_LOCATION"],
      "package": "com.veltriventures.fieldsoli",
      "icon": "./assets/brand/fieldsoli-solo-notch-light.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/fieldsoli-solo-notch-adaptive-fg.png",
        "monochromeImage": "./assets/brand/fieldsoli-solo-notch-monochrome.png",
        "backgroundColor": "#FAF6F0"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow FieldSoli to use your location to suggest nearby addresses.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow FieldSoli to choose a contact for this Job."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/fieldsoli-solo-notch-light.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF6F0"
        }
      ],
      "expo-status-bar",
      "./plugins/with-android-landscape"
    ],
    "extra": {
      "eas": {
        "projectId": "547bd19d-155f-4eaa-83e8-aae669fb6b98"
      }
    },
    "owner": "veltrija"
  }
}
