{
  "name": "mobile-expo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:go": "expo start --android",
    "ios": "expo run:ios",
    "ios:go": "expo start --ios",
    "prebuild:android": "expo prebuild --platform android --clean",
    "web": "expo start --web",
    "export:ios:production": "FIELDSOLO_RELEASE_EXPORT=true EXPO_PUBLIC_APP_ENV=production EXPO_PUBLIC_IS_TESTFLIGHT=false EXPO_PUBLIC_ANALYTICS_DEBUG_RICH=false expo export --platform ios",
    "test": "jest --config ./jest.config.js",
    "test:watch": "jest --config ./jest.config.js --watch"
  },
  "dependencies": {
    "@expo-google-fonts/pt-serif": "^0.4.1",
    "@expo-google-fonts/ubuntu": "^0.4.1",
    "@expo/metro-runtime": "~57.0.15",
    "@fieldsolo/api-client": "*",
    "@fieldsolo/design-system": "^0.0.0",
    "@fieldsolo/shared-types": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "^2.11.4",
    "expo": "~57.0.17",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.18",
    "expo-contacts": "~57.0.6",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "^19.2.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-svg"
      ]
    }
  }
}
