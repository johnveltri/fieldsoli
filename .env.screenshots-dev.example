# Copy to .env.screenshots-dev.local (ignored by Git).
# Supabase personal access token; use permissions restricted to the Dev project
# where available: project read, database read/write, API key/secret read.
# Create at https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Leave unset to generate and save a separate random password on first run.
# DEV_SCREENSHOT_PASSWORD=
